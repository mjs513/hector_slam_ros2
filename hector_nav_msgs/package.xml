<?xml version="1.0"?>
<package format="3">
  <name>hector_nav_msgs</name>
  <version>0.5.0</version>
  <description>Navigation-related messages for Hector SLAM.</description>

  <maintainer email="CyberMerln@gmail.com">Michael</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Dependencies needed for generating ResetMapping.srv -->
  <depend>geometry_msgs</depend>
  <depend>rosidl_default_runtime</depend>

  <!-- REQUIRED for any package that installs .srv/.msg -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
